{
  "name": "gridsync",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "GridSync — Intelligent Monitoring, Predictive Maintenance and Optimization for Renewable Microgrids",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "tsx scripts/acceptance-test.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "seed": "tsx scripts/seed.ts",
    "indexes": "tsx scripts/ensure-indexes.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "ml:generate": "tsx scripts/generate-dataset.ts",
    "ml:train": "python ml/training/train_classifier.py",
    "ml:evaluate": "python ml/evaluation/evaluate.py",
    "ml:pipeline": "npm run ml:generate && npm run ml:train && npm run ml:evaluate"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "google-auth-library": "^9.15.0",
    "i18next": "^24.2.0",
    "jose": "^5.9.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "mongodb": "^6.12.0",
    "mqtt": "^5.10.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
